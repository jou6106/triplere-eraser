# ---- Triple Re Eraser additions (appended to configs/shredos_defconfig) ----
# Prefer hash-checked source archives before contacting upstream Git servers.
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_BACKUP_SITE="https://sources.buildroot.net"
# Keep compiler caching disabled, as in the current Triple Re configuration.
# BR2_CCACHE is not set

# No Mesa 3D / LLVM: the wipe screens are text mode (kernel KMS/framebuffer), and
# building LLVM + Clang alone took ~3 hours, past the CI job time limit.
# BR2_PACKAGE_MESA3D is not set

# Wi-Fi: wpa_supplicant + iw + regulatory database
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y

# Text-mode menus for the Wi-Fi screen
BR2_PACKAGE_DIALOG=y

# HTTPS uploads to the ERP: curl with OpenSSL + CA certificates
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
# openssl command: verifies the USB licence signature
BR2_PACKAGE_LIBOPENSSL_BIN=y

# BusyBox extras: ntpd (clock sync for HTTPS), timeout, rfkill
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/shredos/triplere-busybox.fragment"

# Wi-Fi firmware for common laptop chips
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3160=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3168=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6000G2A=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6000G2B=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA998X=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# Triple Re name instead of ShredOS on the console and on the network (DHCP host name)
BR2_TARGET_GENERIC_HOSTNAME="triplere"
BR2_TARGET_GENERIC_ISSUE="Triple Re Eraser"

# Graphical screens: Python + Pillow drawing on the kernel framebuffer (/dev/fb0).
# No X server / Wayland / Mesa: these are small packages (minutes, not hours, to build).
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
