#!/bin/sh
# Started by ShredOS' /etc/init.d/rcS before nwipe_launcher opens on tty1.

case "$1" in
    start|"")
        /usr/bin/triplere_hw_inventory.sh
        # Background uploader: waits for nwipe to finish, then sends the files to the ERP.
        setsid /usr/bin/triplere_uploader.sh >/dev/null 2>&1 < /dev/null &
        ;;
    *)
        ;;
esac

exit 0
