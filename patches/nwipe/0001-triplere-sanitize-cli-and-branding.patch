diff --git a/src/se_cli.c b/src/se_cli.c
new file mode 100644
index 0000000..b90ae72
--- /dev/null
+++ b/src/se_cli.c
@@ -0,0 +1,430 @@
+/*
+ *  se_cli.c: Firmware sanitize without the ncurses screens (--sanitize, used with --nogui --autonuke).
+ *
+ *  This file only orchestrates. Every device command goes through the same functions that the
+ *  interactive screens in se_nvme_gui.c / se_ata_gui.c use (se_nvme.c / se_ata.c), and the log
+ *  lines and PDF report are the same as when a technician runs the sanitize from those screens.
+ *
+ *  Progress is written to the log as "<device>: SANITIZE progress <n>%" for a front end to follow.
+ *
+ *  This program is free software; you can redistribute it and/or modify it under
+ *  the terms of the GNU General Public License as published by the Free Software
+ *  Foundation, version 2.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h> /* HAVE_LIBNVME */
+#endif
+
+#ifndef _DEFAULT_SOURCE
+#define _DEFAULT_SOURCE
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "nwipe.h"
+#include "context.h"
+#include "options.h"
+#include "logging.h"
+#include "se_ata.h"
+#include "se_nvme.h"
+#include "se_cli.h"
+#include "create_pdf.h"
+#include "miscellaneous.h"
+
+extern int terminate_signal;
+extern nwipe_thread_data_ptr_t* global_nwipe_thread_data_ptr;
+
+/* Poll once a second; give up after this many consecutive failed polls (some controllers
+ * reject admin commands for a while during a sanitize). */
+#define NWIPE_SE_CLI_MAX_POLL_ERRORS 900
+
+/* Final outcome of one device */
+typedef enum {
+    NWIPE_SE_CLI_OK = 0,
+    NWIPE_SE_CLI_FAILED,
+    NWIPE_SE_CLI_UNSUPPORTED
+} nwipe_se_cli_result_e;
+
+static void nwipe_se_cli_finish_pdf( nwipe_context_t* ctx )
+{
+    /* Same as leaving the result screen of the interactive sanitize: PDFs are only created for
+     * destructive methods, which are the only ones this mode starts. */
+    calculate_duration_string( ctx );
+    ctx->secure_erase_orchestration = NWIPE_SECURE_ERASE_ORCHESTRATION_STANDALONE;
+    if( nwipe_options.PDF_enable == 1 )
+    {
+        create_single_disc_pdf( global_nwipe_thread_data_ptr, ctx );
+    }
+    ctx->secure_erase_orchestration = NWIPE_SECURE_ERASE_ORCHESTRATION_UNKNOWN;
+}
+
+/* --------------------------------------------------------------------------------------------- */
+/* NVMe                                                                                          */
+/* --------------------------------------------------------------------------------------------- */
+#ifdef HAVE_LIBNVME
+
+static const char* nwipe_se_cli_nvme_action_str( enum nvme_sanitize_sanact act )
+{
+    /* Labels match nwipe_gui_se_nvme_actions[] so the log lines are identical */
+    switch( act )
+    {
+        case NVME_SANITIZE_SANACT_START_BLOCK_ERASE:
+            return "Block Erase";
+        case NVME_SANITIZE_SANACT_START_CRYPTO_ERASE:
+            return "Crypto Erase";
+        case NVME_SANITIZE_SANACT_START_OVERWRITE:
+            return "Overwrite";
+        default:
+            return "Unknown";
+    }
+}
+
+static void nwipe_se_cli_nvme_set_method( nwipe_context_t* ctx, enum nvme_sanitize_sanact act )
+{
+    switch( act )
+    {
+        case NVME_SANITIZE_SANACT_START_BLOCK_ERASE:
+            ctx->secure_erase_method = NWIPE_SECURE_ERASE_METHOD_BLOCK;
+            break;
+        case NVME_SANITIZE_SANACT_START_CRYPTO_ERASE:
+            ctx->secure_erase_method = NWIPE_SECURE_ERASE_METHOD_CRYPTO;
+            break;
+        case NVME_SANITIZE_SANACT_START_OVERWRITE:
+            ctx->secure_erase_method = NWIPE_SECURE_ERASE_METHOD_OVERWRITE;
+            break;
+        default:
+            ctx->secure_erase_method = NWIPE_SECURE_ERASE_METHOD_UNKNOWN;
+            break;
+    }
+}
+
+static nwipe_se_cli_result_e nwipe_se_cli_nvme( nwipe_context_t* ctx, int mode )
+{
+    nwipe_se_nvme_ctx* san = (nwipe_se_nvme_ctx*) ctx->secure_erase_context;
+    enum nvme_sanitize_sanact act;
+    int poll_errors = 0;
+    int last_pct = -1;
+    int resumed = 0;
+
+    if( mode == NWIPE_SANITIZE_BLOCK && san->cap_block_erase )
+        act = NVME_SANITIZE_SANACT_START_BLOCK_ERASE;
+    else if( mode == NWIPE_SANITIZE_CRYPTO && san->cap_crypto_erase )
+        act = NVME_SANITIZE_SANACT_START_CRYPTO_ERASE;
+    else if( mode == NWIPE_SANITIZE_AUTO && san->cap_block_erase )
+        act = NVME_SANITIZE_SANACT_START_BLOCK_ERASE;
+    else if( mode == NWIPE_SANITIZE_AUTO && san->cap_crypto_erase )
+        act = NVME_SANITIZE_SANACT_START_CRYPTO_ERASE;
+    else
+    {
+        nwipe_log( NWIPE_LOG_ERROR,
+                   "%s: SANITIZE not supported for the requested method (block=%d crypto=%d)",
+                   ctx->device_name,
+                   san->cap_block_erase,
+                   san->cap_crypto_erase );
+        return NWIPE_SE_CLI_UNSUPPORTED;
+    }
+
+    if( nwipe_se_nvme_open( san ) != 0 )
+    {
+        nwipe_log( NWIPE_LOG_ERROR, "%s: Failed to open NVMe controller: %s", ctx->device_name, san->error_msg );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    if( nwipe_se_nvme_poll( san ) != 0 )
+    {
+        nwipe_log( NWIPE_LOG_ERROR, "%s: Failed to read the sanitize log page: %s", ctx->device_name, san->error_msg );
+        nwipe_se_nvme_close( san );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    time( &ctx->start_time );
+    ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_IN_PROGRESS;
+
+    if( san->state == NWIPE_SE_NVME_STATE_IN_PROGRESS )
+    {
+        /* A sanitize is already running (e.g. started before a reboot): follow it, as the
+         * interactive screen offers to do. */
+        nwipe_log( NWIPE_LOG_INFO, "%s: SANITIZE already in progress, monitoring it", san->ctrl_path );
+        nwipe_se_cli_nvme_set_method( ctx, san->sanact );
+        resumed = 1;
+    }
+    else
+    {
+        san->planned_sanact = act;
+        san->destructive_sanact = nwipe_se_nvme_sanact_is_destructive( act );
+        nwipe_log( NWIPE_LOG_INFO,
+                   "%s: starting SANITIZE '%s' on controller %s",
+                   ctx->device_name,
+                   nwipe_se_cli_nvme_action_str( act ),
+                   san->ctrl_path );
+        if( nwipe_se_nvme_sanitize( san ) != 0 )
+        {
+            nwipe_log(
+                NWIPE_LOG_ERROR, "%s: Sanitize command was rejected by device: %s", ctx->device_name, san->error_msg );
+            ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_FAILURE;
+            nwipe_se_nvme_close( san );
+            return NWIPE_SE_CLI_FAILED;
+        }
+        nwipe_se_cli_nvme_set_method( ctx, act );
+    }
+
+    while( terminate_signal != 1 )
+    {
+        sleep( 1 );
+        if( nwipe_se_nvme_poll( san ) != 0 )
+        {
+            if( ++poll_errors >= NWIPE_SE_CLI_MAX_POLL_ERRORS )
+            {
+                nwipe_log( NWIPE_LOG_ERROR, "%s: gave up reading the sanitize status", ctx->device_name );
+                break;
+            }
+            continue;
+        }
+        poll_errors = 0;
+
+        if( resumed && san->sanact > 0 )
+            nwipe_se_cli_nvme_set_method( ctx, san->sanact );
+
+        if( san->state == NWIPE_SE_NVME_STATE_IN_PROGRESS )
+        {
+            if( san->progress_pct != last_pct )
+            {
+                nwipe_log( NWIPE_LOG_INFO, "%s: SANITIZE progress %d%%", ctx->device_name, san->progress_pct );
+                last_pct = san->progress_pct;
+            }
+            continue;
+        }
+        break;
+    }
+
+    if( san->state == NWIPE_SE_NVME_STATE_SUCCESS && poll_errors == 0 && terminate_signal != 1 )
+    {
+        ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_SUCCESS;
+        nwipe_log( NWIPE_LOG_INFO,
+                   "%s: SANITIZE action '%s' was successful.",
+                   san->ctrl_path,
+                   nwipe_se_cli_nvme_action_str( resumed ? san->sanact : act ) );
+        nwipe_se_nvme_close( san );
+        nwipe_se_cli_finish_pdf( ctx );
+        return NWIPE_SE_CLI_OK;
+    }
+
+    if( terminate_signal == 1 )
+    {
+        nwipe_log( NWIPE_LOG_WARNING,
+                   "%s: stopped monitoring; the sanitize may still be running on the device. Do not power off.",
+                   ctx->device_name );
+        nwipe_se_nvme_close( san );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_FAILURE;
+    nwipe_log( NWIPE_LOG_ERROR,
+               "%s: SANITIZE action '%s' has failed.",
+               san->ctrl_path,
+               nwipe_se_cli_nvme_action_str( resumed ? san->sanact : act ) );
+    nwipe_se_nvme_close( san );
+    nwipe_se_cli_finish_pdf( ctx );
+    return NWIPE_SE_CLI_FAILED;
+}
+
+#endif /* HAVE_LIBNVME */
+
+/* --------------------------------------------------------------------------------------------- */
+/* ATA                                                                                           */
+/* --------------------------------------------------------------------------------------------- */
+
+static const char* nwipe_se_cli_ata_action_str( nwipe_se_ata_sanact_e act )
+{
+    /* Labels match nwipe_gui_se_ata_actions[] so the log lines are identical */
+    switch( act )
+    {
+        case NWIPE_SE_ATA_SANACT_BLOCK_ERASE:
+            return "Block Erase";
+        case NWIPE_SE_ATA_SANACT_CRYPTO_SCRAMBLE:
+            return "Crypto Scramble";
+        case NWIPE_SE_ATA_SANACT_OVERWRITE:
+            return "Overwrite";
+        default:
+            return "Unknown";
+    }
+}
+
+static nwipe_se_cli_result_e nwipe_se_cli_ata( nwipe_context_t* ctx, int mode )
+{
+    nwipe_se_ata_ctx* san = (nwipe_se_ata_ctx*) ctx->secure_erase_context;
+    nwipe_se_ata_sanact_e act;
+    int poll_errors = 0;
+    int last_pct = -1;
+    int resumed = 0;
+
+    if( mode == NWIPE_SANITIZE_BLOCK && san->cap_block_erase )
+        act = NWIPE_SE_ATA_SANACT_BLOCK_ERASE;
+    else if( mode == NWIPE_SANITIZE_CRYPTO && san->cap_crypto_erase )
+        act = NWIPE_SE_ATA_SANACT_CRYPTO_SCRAMBLE;
+    else if( mode == NWIPE_SANITIZE_AUTO && san->cap_block_erase )
+        act = NWIPE_SE_ATA_SANACT_BLOCK_ERASE;
+    else if( mode == NWIPE_SANITIZE_AUTO && san->cap_crypto_erase )
+        act = NWIPE_SE_ATA_SANACT_CRYPTO_SCRAMBLE;
+    else
+    {
+        nwipe_log( NWIPE_LOG_ERROR,
+                   "%s: SANITIZE not supported for the requested method (block=%d crypto=%d)",
+                   ctx->device_name,
+                   san->cap_block_erase,
+                   san->cap_crypto_erase );
+        return NWIPE_SE_CLI_UNSUPPORTED;
+    }
+
+    if( nwipe_se_ata_open( san ) != 0 )
+    {
+        nwipe_log( NWIPE_LOG_ERROR, "%s: Failed to open ATA device: %s", ctx->device_name, san->error_msg );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    if( nwipe_se_ata_poll( san ) != 0 )
+    {
+        nwipe_log( NWIPE_LOG_ERROR, "%s: Failed to read the sanitize status: %s", ctx->device_name, san->error_msg );
+        nwipe_se_ata_close( san );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    if( san->state == NWIPE_SE_ATA_STATE_FROZEN )
+    {
+        nwipe_log( NWIPE_LOG_ERROR,
+                   "%s: SANITIZE not possible, the drive is frozen by the BIOS (sleep/wake the laptop to unfreeze)",
+                   ctx->device_name );
+        nwipe_se_ata_close( san );
+        return NWIPE_SE_CLI_UNSUPPORTED;
+    }
+
+    time( &ctx->start_time );
+    ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_IN_PROGRESS;
+
+    if( san->state == NWIPE_SE_ATA_STATE_IN_PROGRESS )
+    {
+        nwipe_log( NWIPE_LOG_INFO, "%s: SANITIZE already in progress, monitoring it", san->device_path );
+        /* ATA does not report which method is running */
+        san->sanact = NWIPE_SE_ATA_SANACT_UNKNOWN;
+        ctx->secure_erase_method = NWIPE_SECURE_ERASE_METHOD_UNKNOWN;
+        resumed = 1;
+    }
+    else
+    {
+        san->planned_sanact = act;
+        san->destructive_sanact = nwipe_se_ata_sanact_is_destructive( act );
+        nwipe_log( NWIPE_LOG_INFO, "%s: starting SANITIZE '%s'", ctx->device_name, nwipe_se_cli_ata_action_str( act ) );
+        if( nwipe_se_ata_sanitize( san ) != 0 )
+        {
+            nwipe_log(
+                NWIPE_LOG_ERROR, "%s: Sanitize command was rejected by device: %s", ctx->device_name, san->error_msg );
+            ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_FAILURE;
+            nwipe_se_ata_close( san );
+            return NWIPE_SE_CLI_FAILED;
+        }
+        ctx->secure_erase_method =
+            ( act == NWIPE_SE_ATA_SANACT_BLOCK_ERASE ) ? NWIPE_SECURE_ERASE_METHOD_BLOCK : NWIPE_SECURE_ERASE_METHOD_CRYPTO;
+    }
+
+    while( terminate_signal != 1 )
+    {
+        sleep( 1 );
+        if( nwipe_se_ata_poll( san ) != 0 )
+        {
+            if( ++poll_errors >= NWIPE_SE_CLI_MAX_POLL_ERRORS )
+            {
+                nwipe_log( NWIPE_LOG_ERROR, "%s: gave up reading the sanitize status", ctx->device_name );
+                break;
+            }
+            continue;
+        }
+        poll_errors = 0;
+
+        if( san->state == NWIPE_SE_ATA_STATE_IN_PROGRESS )
+        {
+            if( san->progress_pct != last_pct )
+            {
+                nwipe_log( NWIPE_LOG_INFO, "%s: SANITIZE progress %d%%", ctx->device_name, san->progress_pct );
+                last_pct = san->progress_pct;
+            }
+            continue;
+        }
+        break;
+    }
+
+    if( san->state == NWIPE_SE_ATA_STATE_SUCCESS && poll_errors == 0 && terminate_signal != 1 )
+    {
+        ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_SUCCESS;
+        nwipe_log( NWIPE_LOG_INFO,
+                   "%s: SANITIZE action '%s' was successful.",
+                   san->device_path,
+                   nwipe_se_cli_ata_action_str( resumed ? NWIPE_SE_ATA_SANACT_UNKNOWN : act ) );
+        nwipe_se_ata_close( san );
+        nwipe_se_cli_finish_pdf( ctx );
+        return NWIPE_SE_CLI_OK;
+    }
+
+    if( terminate_signal == 1 )
+    {
+        nwipe_log( NWIPE_LOG_WARNING,
+                   "%s: stopped monitoring; the sanitize may still be running on the device. Do not power off.",
+                   ctx->device_name );
+        nwipe_se_ata_close( san );
+        return NWIPE_SE_CLI_FAILED;
+    }
+
+    ctx->secure_erase_status = NWIPE_SECURE_ERASE_STATUS_FAILURE;
+    nwipe_log( NWIPE_LOG_ERROR,
+               "%s: SANITIZE action '%s' has failed.",
+               san->device_path,
+               nwipe_se_cli_ata_action_str( resumed ? NWIPE_SE_ATA_SANACT_UNKNOWN : act ) );
+    nwipe_se_ata_close( san );
+    nwipe_se_cli_finish_pdf( ctx );
+    return NWIPE_SE_CLI_FAILED;
+}
+
+/* --------------------------------------------------------------------------------------------- */
+
+int nwipe_se_cli_sanitize_all( nwipe_context_t** c, int count )
+{
+    int i;
+    int failures = 0;
+
+    for( i = 0; i < count && terminate_signal != 1; i++ )
+    {
+        nwipe_context_t* ctx = c[i];
+        nwipe_se_cli_result_e r = NWIPE_SE_CLI_UNSUPPORTED;
+
+        if( ctx->device_busy && !nwipe_options.force )
+        {
+            nwipe_log( NWIPE_LOG_FATAL, "Device '%s' is IN USE but --force is not set, not sanitizing it.", ctx->device_name );
+            failures++;
+            continue;
+        }
+
+        if( ctx->secure_erase_supported == 1 && ctx->secure_erase_context != NULL )
+        {
+#ifdef HAVE_LIBNVME
+            if( ctx->secure_erase_type == NWIPE_SECURE_ERASE_TYPE_NVME )
+                r = nwipe_se_cli_nvme( ctx, nwipe_options.sanitize );
+#endif
+            if( ctx->secure_erase_type == NWIPE_SECURE_ERASE_TYPE_ATA )
+                r = nwipe_se_cli_ata( ctx, nwipe_options.sanitize );
+        }
+
+        if( r == NWIPE_SE_CLI_UNSUPPORTED )
+        {
+            /* Front ends look for this line to offer an overwrite wipe instead */
+            nwipe_log( NWIPE_LOG_ERROR, "%s: SANITIZE unsupported on this device", ctx->device_name );
+        }
+        if( r != NWIPE_SE_CLI_OK )
+            failures++;
+    }
+
+    return failures ? 1 : 0;
+}
