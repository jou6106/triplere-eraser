+#ifndef SE_CLI_H_
+#define SE_CLI_H_
+
+#include "context.h"
+
+/* Values of nwipe_options.sanitize */
+#define NWIPE_SANITIZE_OFF 0
+#define NWIPE_SANITIZE_AUTO 1 /* Block Erase if supported, else Crypto Erase */
+#define NWIPE_SANITIZE_BLOCK 2
+#define NWIPE_SANITIZE_CRYPTO 3
+
+/* Sanitizes the given (selected) devices one after the other, logs the result the same way as
+ * the interactive sanitize screens and creates a PDF report per device.
+ * Returns 0 when every device was sanitized successfully, 1 otherwise. */
+int nwipe_se_cli_sanitize_all( nwipe_context_t** c, int count );
+
+#endif /* SE_CLI_H_ */
